# Godot 4+ specific ignores
# ======================================
# Godot 引擎自动生成的缓存（必须忽略）
# ======================================
.godot/
/android/

# ======================================
# 游戏导出文件（打包后的游戏，不用提交）
# ======================================
*.exe
*.apk
*.ipa
*.pck
*.zip
*.desktop
*.exe
*.apk
*.ipa
*.pck
*.zip
*.desktop

# ======================================
# 编辑器 / 个人配置文件（你之前的mcp.json）
# ======================================
.claude/
.mcp.json
.lsp.json
.vscode/
.vs/
.mono/

# ======================================
# 系统垃圾文件（通用忽略）
# ======================================
Thumbs.db
.DS_Store
*.log